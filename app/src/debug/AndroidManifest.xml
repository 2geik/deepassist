<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only. DUMP is held by the adb shell, not by apps, so only
             adb can drive these test hooks. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.deepassist.DEBUG_PROMPT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
